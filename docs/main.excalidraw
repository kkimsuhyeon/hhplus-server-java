    {
      "id": "YsiHYYSWfUH_AMOyCTZEH",
      "type": "text",
      "x": 1350,
      "y": 160,
      "width": 516.0,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
